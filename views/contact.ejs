<%- include("partials/header") %>

<section class="contact-hero">
        <div class="contact-container">
            <div class="contact-hero-content">
                <h1 class="contact-hero-title">
                    Contáctanos
                </h1>
                <p class="contact-hero-text">
                    ¿Tienes preguntas, quieres organizar un evento o aprender skate?
                    Escríbenos y sé parte de la comunidad de MonchoPark.
                </p>
            </div>
        </div>
    </section>

    <section class="contact-section">
        <div class="hero-filler"></div>
        <div class="contact-container">
            <div class="contact-content">
                <div class="contact-info">

                    <h2 class="contact-title">
                        MonchoPark
                    </h2>

                    <p class="contact-description">
                        Un skatepark creado para impulsar la cultura skate en San Ramón.
                        Organizamos eventos, clases y actividades para todos los niveles.
                    </p>

                    <div class="contact-details">
                        <div class="contact-item">
                            <h4>Ubicación</h4>
                            <p>San Ramón, Alajuela, Costa Rica</p>
                        </div>

                        <div class="contact-item">
                            <h4>Horario</h4>
                            <p>Lunes - Domingo<br>9:00 AM - 8:00 PM</p>
                        </div>

                        <div class="contact-item">
                            <h4>Email</h4>
                            <p>monchopark@gmail.com</p>
                        </div>

                        <div class="contact-item">
                            <h4>Instagram</h4>
                            <p>@monchopark</p>
                        </div>
                    </div>
                </div>


                <!-- FORM -->

                <div class="contact-form-wrapper">
                    <form class="contact-form" id="contact-form">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Nombre</label>
                                <input type="text" id="first-name" required>
                            </div>

                            <div class="form-group">
                                <label>Apellido</label>
                                <input type="text" id="last-name" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" id="email" required>
                            </div>

                            <div class="form-group">
                                <label>Confirmar Email</label>
                                <input type="email" id="confirm-email" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Mensaje</label>
                            <textarea id="message" maxlength="600" required></textarea>
                            <span class="char-count">0 / 600</span>
                        </div>

                        <button class="submit-btn">
                            Enviar mensaje
                        </button>
                        <p class="form-message" id="form-message"></p>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <script src="/js/contact.js"></script>
