<%
    const fieldRows = [
        [
            { id: "first-name", label: "Nombre", type: "text", autocomplete: "given-name" },
            { id: "last-name", label: "Apellido", type: "text", autocomplete: "family-name" },
        ],
        [
            { id: "email", label: "Email", type: "email", autocomplete: "email" },
            { id: "confirm-email", label: "Confirmar Email", type: "email", autocomplete: "off" },
        ],
    ];
%>
<%- include("partials/page-hero", { sectionClass: "contact-hero", prefix: "contact", heading: "Contáctanos" }) %>

<section class="contact-section">
    <div class="hero-filler"></div>
    <div class="contact-container">
        <div class="contact-content">
            <div class="contact-info">
                <h2 class="contact-title">Información de contacto</h2>

                <p class="contact-description">
                    Si no encuentras la información que buscas en nuestro sitio web,
                    puedes enviarnos un mensaje mediante el formulario y con gusto
                    intentaremos ayudarte.
                </p>

                <div class="contact-details">
                    <% details.forEach((item) => { %>
                    <div class="contact-item">
                        <h4><%= item.title %></h4>
                        <p><% (item.lines || [item.text]).forEach((line, i) => { %><% if (i) { %><br><% } %><%= line %><% }) %></p>
                    </div>
                    <% }) %>
                </div>
            </div>

            <div class="contact-form-wrapper">
                <form class="contact-form" id="contact-form" novalidate>
                    <% fieldRows.forEach((row) => { %>
                    <div class="form-row">
                        <% row.forEach((field) => { %>
                        <div class="form-group">
                            <label for="<%= field.id %>"><%= field.label %></label>
                            <input type="<%= field.type %>" id="<%= field.id %>" name="<%= field.id %>"
                                data-label="<%= field.label %>" autocomplete="<%= field.autocomplete %>" required>
                            <small class="error-message" aria-live="polite"></small>
                        </div>
                        <% }) %>
                    </div>
                    <% }) %>

                    <div class="text-area-div">
                        <div class="form-group">
                            <label for="message">Mensaje</label>
                            <textarea id="message" name="message" maxlength="600" required></textarea>
                            <small class="error-message"></small>
                            <span class="char-count">0 / 600</span>
                        </div>
                    </div>

                    <button type="submit" class="custome-btn">
                        <span>Enviar mensaje</span>
                        <%- include("partials/ui/arrow-icon") %>
                    </button>

                    <template class="sent-template">
                        ¡Enviado! <img src="/images/icons/checked.webp" alt=""
                            style="width:20px; vertical-align:middle; margin-left:5px;" />
                    </template>
                </form>
            </div>
        </div>
    </div>
</section>
