<section class="shop-detail-section">
    <%- include("partials/header") %>

        <div class="shop-wall">
            <div class="deck-row">
                <img src="/images/shop/deck-8.png" class="deck-img">
                <img src="/images/slider/item-2.png" class="deck-img">
                <img src="/images/shop/deck-7.png" class="deck-img">
                <img src="/images/shop/deck-14.png" class="deck-img">
                <img src="/images/shop/deck-11.png" class="deck-img">
                <img src="/images/shop/deck-17.png" class="deck-img">
            </div>

            <div class="deck-row">
                <img src="/images/shop/deck-9.png" class="deck-img">
                <img src="/images/shop/deck-10.png" class="deck-img">
                <img src="/images/shop/deck-15.png" class="deck-img">
                <img src="/images/shop/deck-12.png" class="deck-img">
                <img src="/images/shop/deck-13.png" class="deck-img">
                <img src="/images/shop/deck-16.png" class="deck-img">
            </div>
        </div>
        <div class="gradient-filler"></div>

        <div class="shop-popup" id="shopPopup">

            <!-- CERRAR -->
            <button class="popup-close" id="closePopup">✕</button>

            <div class="popup-wrapper">

                <!-- IZQUIERDA (TABLA) -->
                <div class="popup-left">

                    <button class="arrow left" id="prevDeck">‹</button>

                    <div class="popup-deck">
                        <img id="popupImage" src="" alt="">
                    </div>

                    <button class="arrow right" id="nextDeck">›</button>

                </div>

                <!-- DERECHA (INFO) -->
                <div class="popup-right">

                    <h2 class="popup-title">MONCHO DECK PRO</h2>

                    <p class="popup-price">₡24,900</p>

                    <p class="popup-desc">
                        Tabla profesional diseñada para street skating.
                        Alta resistencia y diseño exclusivo.
                    </p>

                    <div class="popup-options">
                        <span>Tamaño: 8.25</span>
                        <span>Stock: Disponible</span>
                    </div>

                    <div class="popup-right">
                        <h2 class="popup-title"></h2>
                        <p class="popup-price"></p>
                        <p class="popup-desc"></p>

                        <div class="popup-actions">
                            <button class="btn yes">Comprar</button>
                            <button class="btn no" id="closePopup">Cancelar</button>
                        </div>
                    </div>

                </div>
            </div>
</section>


<!-- RELATED ITEMS -->
<section class="related-section">

    <h2 class="related-title">Productos relacionados</h2>

    <div class="related-grid">

        <div class="related-card">
            <div class="related-div">
                <img src="/images/shop/deck-1.png">
                <h3>Tabla Street Pro</h3>
                <p class="price">₡24,900</p>
            </div>
        </div>

        <div class="related-card">
            <div class="related-div">
                <img src="/images/shop/deck-2.png">
                <h3>Deck Moncho Classic</h3>
                <p class="price">₡19,900</p>
            </div>
        </div>

        <div class="related-card">
            <div class="related-div">
                <img src="/images/shop/deck-3.png">
                <h3>Tabla Neon Vibes</h3>
                <p class="price">₡27,500</p>
            </div>
        </div>

        <div class="related-card">
            <div class="related-div">
                <img src="/images/shop/deck-6.png">
                <h3>Deck Black Edition</h3>
                <p class="price">₡22,000</p>
            </div>
        </div>
    </div>

</section>

<script src="/js/shop.js" defer></script>