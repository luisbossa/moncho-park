<section class="shop-detail-section">
    <%- include("partials/header") %>

        <div class="shop-wall">
            <div class="deck-row">
                <img src="/images/shop/deck-8.png" class="deck-img" data-id="0">
                <img src="/images/slider/item-2.png" class="deck-img" data-id="1">
                <img src="/images/shop/deck-7.png" class="deck-img" data-id="2">
                <img src="/images/shop/deck-14.png" class="deck-img" data-id="3">
                <img src="/images/shop/deck-11.png" class="deck-img" data-id="4">
                <img src="/images/shop/deck-17.png" class="deck-img" data-id="5">
            </div>

            <div class="deck-row">
                <img src="/images/shop/deck-9.png" class="deck-img" data-id="6">
                <img src="/images/shop/deck-10.png" class="deck-img" data-id="7">
                <img src="/images/shop/deck-15.png" class="deck-img" data-id="8">
                <img src="/images/shop/deck-12.png" class="deck-img" data-id="9">
                <img src="/images/shop/deck-13.png" class="deck-img" data-id="10">
                <img src="/images/shop/deck-16.png" class="deck-img" data-id="11">
            </div>
        </div>
        <div class="gradient-filler"></div>

        <div class="shop-popup" id="shopPopup">
            <button class="popup-close" id="closePopup">✕</button>

            <div class="popup-hud">
                <div class="hud-avatar">
                    <img src="/images/logo.png" alt="Logo user">
                </div>

                <div class="hud-info">
                    <span class="hud-name">SkateMoncho</span>
                    <span class="hud-level">Nivel 8</span>

                    <div class="hud-bar">
                        <div class="hud-bar-fill"></div>
                    </div>
                </div>

                <div class="hud-money">₡ 120,000</div>
            </div>

            <div class="popup-wrapper">
                <!-- TABLA -->
                <div class="popup-left">

                    <button class="arrow left" id="prevDeck">‹</button>

                    <div class="popup-deck">
                        <img id="popupImage" src="" alt="">
                    </div>

                    <button class="arrow right" id="nextDeck">›</button>

                </div>

                <!-- DERECHA (INFO) -->
                <div class="popup-right">

                    <h2 class="popup-title">DECK PRO</h2>

                    <p class="popup-price">₡ 24,900</p>

                    <p class="popup-desc">
                        Tabla profesional diseñada para street skating y diseño exclusivo.
                    </p>

                    <div class="popup-options">
                        <span id="popupSize"></span>
                    </div>

                    <div class="">
                        <h2 class="popup-title"></h2>
                        <p class="popup-price"></p>
                        <p class="popup-desc"></p>

                        <div class="popup-actions">
                            <button class="btn yes">Comprar</button>
                            <button class="btn no" id="closePopup">Cancelar</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
</section>


<!-- RELATED ITEMS -->
<section class="related-section">
    <h2 class="related-title">Otros productos</h2>

    <div class="related-grid" id="relatedGrid"></div>
</section>

<script src="/js/pop-up.js"></script>
<script src="/js/related.js"></script>
<script src="/js/hud.js"></script>