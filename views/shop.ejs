<%
    const ROW_SIZE = 6;
    const rows = [];
    for (let i = 0; i < products.length; i += ROW_SIZE) rows.push(products.slice(i, i + ROW_SIZE));
    const first = products[0];
%>
<section class="shop-detail-section">
    <%- include("partials/header") %>

    <div class="shop-wall">
        <p class="shop-hint">Elige una tabla para verla de cerca</p>
        <% rows.forEach((row) => { %>
        <div class="deck-row">
            <% row.forEach((product) => { %>
            <img src="<%= product.img %>" class="deck-img" alt="<%= product.name %>" data-list="products"
                <%- include("partials/shop/deck-data", { product }) %>>
            <% }) %>
        </div>
        <% }) %>
    </div>
    <div class="gradient-filler"></div>

    <div class="shop-popup" id="shopPopup" role="dialog" aria-modal="true" aria-labelledby="popupTitle" aria-hidden="true">
        <button class="popup-close" type="button" data-close-popup aria-label="Cerrar">✕</button>

        <div class="popup-hud">
            <div class="hud-avatar">
                <img src="/images/logo.png" alt="">
            </div>

            <div class="hud-info">
                <span class="hud-name">SkateMoncho</span>
                <span class="hud-level">Nivel 8</span>

                <div class="hud-bar">
                    <div class="hud-bar-fill"></div>
                </div>
            </div>

            <div class="hud-money" data-money="<%= startingMoney %>"><%= formatCRC(startingMoney) %></div>
        </div>

        <div class="popup-wrapper">
            <div class="popup-left">
                <button class="arrow left" type="button" id="prevDeck" aria-label="Producto anterior">‹</button>

                <div class="popup-deck">
                    <img id="popupImage" src="<%= first.img %>" alt="<%= first.name %>">
                </div>

                <button class="arrow right" type="button" id="nextDeck" aria-label="Producto siguiente">›</button>
            </div>

            <div class="popup-right">
                <h2 class="popup-title" id="popupTitle"><%= first.name %></h2>
                <p class="popup-price"><%= formatCRC(first.price) %></p>
                <p class="popup-desc"><%= first.desc %></p>

                <div class="popup-options">
                    <span class="popup-chip" id="popupSize">Tamaño: <%= first.size %></span>
                    <span class="popup-chip popup-stock" id="popupStock" data-stock="<%= first.stock %>"><%= first.stock %></span>
                </div>

                <div class="popup-actions">
                    <button class="btn yes" type="button">Comprar</button>
                    <button class="btn no" type="button" data-close-popup>Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="related-section">
    <h2 class="related-title">Otros productos</h2>
    <p class="related-hint">Toca una tabla para ver sus detalles.</p>

    <div class="related-grid" id="relatedGrid">
        <% related.forEach((product) => { %>
        <div class="related-card" data-list="related" <%- include("partials/shop/deck-data", { product }) %>>
            <div class="related-div">
                <div class="related-img-div">
                    <img src="<%= product.img %>" alt="<%= product.name %>" loading="lazy">
                </div>
                <h3><%= product.name %></h3>
                <p class="price"><%= formatCRC(product.price) %></p>
            </div>
        </div>
        <% }) %>
    </div>
</section>

<div class="game-msg" role="status" aria-live="polite"></div>
