<%
    const navLink = (link) =>
        `<li><a href="${link.href}"${link.href === currentPath ? ' aria-current="page"' : ""}>${link.label}</a></li>`;
%>
<header class="main-header">
    <div class="header-container">
        <nav class="main-nav" aria-label="Principal">
            <ul>
                <%- site.mainNav.map(navLink).join("") %>
            </ul>
        </nav>

        <div class="mobile-header-container">
            <button class="mobile-menu-toggle" aria-label="Abrir menú" aria-expanded="false"
                aria-controls="mobile-menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>

        <a href="/" class="logo" aria-label="Moncho Park - Inicio">
            <img src="/images/logo.png" alt="Moncho Park" width="100" height="100">
        </a>

        <div class="user-nav">
            <div class="nav-wrapper">
                <a href="/donate"<%- currentPath === "/donate" ? ' aria-current="page"' : "" %>>Donar</a>
            </div>

            <a href="/contact" class="custome-a">
                <span>Contactar</span>
                <%- include("ui/arrow-icon") %>
            </a>
        </div>
    </div>
</header>

<!-- MOBILE MENU (fuera del header para que position: fixed cubra toda la pantalla) -->
<div class="mobile-header">
    <nav class="mobile-menu" id="mobile-menu" aria-label="Menú móvil">
        <ul>
            <%- [...site.mainNav, ...site.mobileExtraNav].map(navLink).join("") %>
        </ul>

        <a class="mobile-menu-mail" href="mailto:<%= site.contact.email %>"><%= site.contact.email %></a>
    </nav>
</div>
