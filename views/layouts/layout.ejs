<body>
    <main class="main">
        <%- body %>
    </main>

    <footer id="footer" class="footer-section">
        <div class="footer-filler"></div>
        <div class="footer-container">
            <div class="footer-logo-div">
                <figure class="footer-logo">
                    <img width="1000" height="545" src="/images/footer-logo.png" alt="Monchopark Logo"" loading="
                        lazy" />
                </figure>
            </div>
            <div class="footer-block">
                <div class="footer-contact">
                    <div class="footer-contact-div">
                        <h2>Detalles de contacto</h2>

                        <div class="footer-info-wrapper">
                            <div class="footer-info-div">
                                <div class="footer-content">
                                    <a class="footer-details"
                                        href="https://www.google.com/maps/place/San+Ramon+Skatepark/@10.0973579,-84.4738183,17.5z/data=!4m15!1m8!3m7!1s0x8fa044f3af84f003:0x5a8a5d7ab4db941f!2sC.+Polideportivo,+Provincia+de+Alajuela,+San+Ram%C3%B3n!3b1!8m2!3d10.099071!4d-84.4732782!16s%2Fg%2F11h54_06tk!3m5!1s0x8fa045005a61177b:0x528c498dc32a947!8m2!3d10.0982839!4d-84.4732607!16s%2Fg%2F11yftbhd46?entry=ttu&g_ep=EgoyMDI2MDMxNy4wIKXMDSoASAFQAw%3D%3D"
                                        target="_blank">
                                        Calle 1, Barrio San Juan
                                        San Ramón, Alajuela
                                        Costa Rica
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="footer-info-wrapper">
                        <div class="footer-info-div">
                            <div class="footer-content">
                                <a class="footer-details" href="mailto:poliskate@gmail.com">
                                    poliskate@gmail.com
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="footer-wrapper">
                    <nav class="footer-nav-wrapper">
                        <div>
                            <h2>Explorar</h2>
                            <ul class="footer-list">
                                <li>
                                    <a class="footer-link" href="/">Inicio</a>
                                </li>
                                <li>
                                    <a class="footer-link" href="/history">Historia</a>
                                </li>
                                <li>
                                    <a class="footer-link" href="/events">Eventos</a>
                                </li>
                                <li>
                                    <a class="footer-link" href="/contact">Contáctanos</a>
                                </li>
                            </ul>
                        </div>

                        <div>
                            <h2>Políticas</h2>
                            <ul class="footer-list">
                                <li>
                                    <a class="footer-link" href="/privacy-policy">Política
                                        de
                                        privacidad</a>
                                </li>
                                <li>
                                    <a class="footer-link" href="/refund-policy">Política de
                                        reembolso</a>
                                </li>
                                <li>
                                    <a class="footer-link" href="/shipping-policy">Política
                                        de envío</a>
                                </li>
                            </ul>
                        </div>

                        <div>
                            <h2>Hacer</h2>
                            <ul class="footer-list">
                                <li>
                                    <a class="footer-link" href="/lessons">
                                        Clases de skate
                                    </a>
                                </li>
                                <li>
                                    <a class="footer-link" href="/donate">
                                        Donar
