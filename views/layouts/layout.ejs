<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= locals.title ? `${title} | ${site.name}` : site.name %></title>
    <meta name="description" content="Moncho Park, el skatepark de San Ramón, Alajuela.">
    <meta name="theme-color" content="#151515">
    <link rel="icon" href="/favicon.ico">

    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= locals.title ? `${title} | ${site.name}` : site.name %>">
    <meta property="og:description" content="Moncho Park, el skatepark de San Ramón, Alajuela.">
    <meta property="og:image" content="/images/logo.png">

    <script>document.documentElement.classList.add("js");</script>

    <link rel="preload" href="/fonts/obviously-bold.otf" as="font" type="font/otf" crossorigin>
    <link rel="preload" href="/fonts/anton.ttf" as="font" type="font/ttf" crossorigin>

    <% [
        "style", "global", "header", "hero", "about", "history", "park-map", "shop", "magazine", "slider",
        "best-sellers", "discount", "brands", "contact", "lessons", "privacy-policy", "donate",
        "events", "pop-up", "shop-game", "ui-btn", "ui-btn2", "footer"
    ].forEach((sheet) => { %>
    <link rel="stylesheet" href="/css/<%= sheet %>.css">
    <% }) %>
</head>

<body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>

    <main class="main" id="main-content" tabindex="-1">
        <%- body %>
    </main>

    <%- include("../partials/footer") %>

    <button class="back-to-top" type="button" aria-label="Volver arriba">↑</button>

    <script src="/js/main.js" defer></script>
    <% (locals.scripts || []).forEach((src) => { %>
    <script src="<%= src %>" defer></script>
    <% }) %>
</body>

</html>
