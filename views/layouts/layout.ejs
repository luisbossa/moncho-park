<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Polideportivo Skatepark</title>
    <link rel="icon" href="/favicon.ico">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/Global.css">
    <link rel="stylesheet" href="/css/Header.css">
    <link rel="stylesheet" href="/css/Hero.css">
    <link rel="stylesheet" href="/css/About.css">
    <link rel="stylesheet" href="/css/History.css">
    <link rel="stylesheet" href="/css/Park-map.css">
    <link rel="stylesheet" href="/css/Shop.css">
    <link rel="stylesheet" href="/css/Slider.css">
    <link rel="stylesheet" href="/css/Best-sellers.css">
    <link rel="stylesheet" href="/css/Discount.css">
    <link rel="stylesheet" href="/css/Brands.css">
    <link rel="stylesheet" href="/css/Contact.css">
    <link rel="stylesheet" href="/css/Lessons.css">
    <link rel="stylesheet" href="/css/Privacy-policy.css">
    <link rel="stylesheet" href="/css/Donate.css">
    <link rel="stylesheet" href="/css/ui-btn.css">
    <link rel="stylesheet" href="/css/ui-btn2.css">
    <link rel="stylesheet" href="/css/Footer.css">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/frontend.min.js"></script>
</head>

<body>
    <main class="main">
        <%- body %>
    </main>

    <footer id="footer">
        <div class="brxe-div fr-footer-kilo">
            <div class="footer-filler"></div>
            <div class="brxe-container fr-footer-kilo__inner">
                <div class="brxe-div fr-footer-kilo__logo-wrapper">
                    <figure class="brxe-image fr-logo fr-footer-kilo__logo">
                        <img width="1000" height="545" src="/images/footer-logo.png" class="css-filter size-full"
                            alt="Camp Hillcrest Logo" decoding="async" loading="lazy"
                            sizes="(max-width: 1000px) 100vw, 1000px" />
                    </figure>
                </div>
                <div class="brxe-block fr-footer-kilo__content-block">
                    <div class="brxe-div fr-footer-kilo__contact-wrapper">
                        <div class="footer-contact-div">
                            <h2 class="brxe-heading fr-contact-section-bravo__heading">Detalles de contacto</h2>

                            <div class="brxe-div fr-contact-info-bravo">
                                <div class="brxe-div fr-contact-info-bravo__info-wrapper">
                                    <div class="brxe-div fr-contact-info-bravo__content-wrapper">
                                        <a class="brxe-text-basic fr-contact-info-bravo__details"
                                            href="https://www.google.com/maps/place/Camp+Hillcrest/" target="_blank">
                                            Calle 1, Barrio San Juan
                                            San Ramón, Alajuela
                                            Costa Rica
                                        </a>
                                    </div>
                                    <div class="brxe-div fr-contact-info-bravo__icon-wrapper">
                                        <i class="ion-ios-pin brxe-icon"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="brxe-div fr-contact-info-bravo">
                            <div class="brxe-div fr-contact-info-bravo__info-wrapper">
                                <div class="brxe-div fr-contact-info-bravo__content-wrapper">
                                    <a class="brxe-text-basic fr-contact-info-bravo__details"
                                        href="mailto:info@camphillcrest.co.uk">
                                        poliskate@gmail.com
                                    </a>
                                </div>
                                <div class="brxe-div fr-contact-info-bravo__icon-wrapper">
                                    <i class="fas fa-envelope brxe-icon"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="brxe-div fr-footer-kilo__content-wrapper">
                        <nav class="brxe-div fr-footer-kilo__nav-wrapper">
                            <div class="brxe-div fr-footer-kilo__nav-column">
                                <h2 class="brxe-heading fr-footer-kilo__heading">Explorar</h2>
                                <ul class="brxe-div fr-footer-kilo__list">
                                    <li class="brxe-div fr-footer-kilo__list-item">
                                        <a class="brxe-text-link fr-footer-kilo__link" href="/">Inicio</a>
                                    </li>
                                    <li class="brxe-div fr-footer-kilo__list-item">
                                        <a class="brxe-text-link fr-footer-kilo__link" href="/history">Historia</a>
                                    </li>
                                    <li class="brxe-div fr-footer-kilo__list-item">
                                        <a class="brxe-text-link fr-footer-kilo__link" href="#">Eventos</a>
                                    </li>
                                    <li class="brxe-div fr-footer-kilo__list-item">
                                        <a class="brxe-text-link fr-footer-kilo__link" href="/contact">Contáctanos</a>
                                    </li>
                                </ul>
                            </div>

                            <div class="brxe-div fr-footer-kilo__nav-column">
                                <h2 class="brxe-heading fr-footer-kilo__heading">Políticas</h2>
                                <ul class="brxe-div fr-footer-kilo__list">
                                    <li class="brxe-div fr-footer-kilo__list-item">
                                        <a class="brxe-text-link fr-footer-kilo__link" href="/privacy-policy">Política de
                                            privacidad</a>
                                    </li>
                                    <li class="brxe-div fr-footer-kilo__list-item">
                                        <a class="brxe-text-link fr-footer-kilo__link" href="/refund-policy">Política de
                                            reembolso</a>
                                    </li>
                                    <li class="brxe-div fr-footer-kilo__list-item">
                                        <a class="brxe-text-link fr-footer-kilo__link" href="/shipping-policy">Política de envío</a>
                                    </li>
                                </ul>
                            </div>

                            <div class="brxe-div fr-footer-kilo__nav-column">
                                <h2 class="brxe-heading fr-footer-kilo__heading">Hacer</h2>
                                <ul class="brxe-div fr-footer-kilo__list">
                                    <li class="brxe-div fr-footer-kilo__list-item">
                                        <a class="brxe-text-link fr-footer-kilo__link" href="/lessons">
                                            Clases de skate
                                        </a>
                                    </li>
                                    <li class="brxe-div fr-footer-kilo__list-item">
                                        <a class="brxe-text-link fr-footer-kilo__link" href="/donate">
                                            Donar
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </nav>

                        <div class="footer-social-wrapper">
                            <h2 class="brxe-heading">Síguenos</h2>
                            <ul class="fr-social-alpha">
                                <li class="fr-social-alpha__list-item">
                                    <a href="#" class="brxe-div social-icon-wrapper">
                                        <img src="/images/icons/facebook.svg" alt="Facebook icon">
                                        <span class="brxe-text-basic hidden-accessible--footer">Síguenos en
                                            Facebook</span>
                                    </a>
                                </li>

                                <li class="fr-social-alpha__list-item">
                                    <a href="#" class="brxe-div social-icon-wrapper">
                                        <img src="/images/icons/instagram.svg" alt="Instagram icon">
                                        <span class="brxe-text-basic hidden-accessible--footer">Síguenos en
                                            Instagram</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="/js/data.js"></script>
    <script src="/js/header.js" defer></script>
    <script src="/js/footer.js" defer></script>
    <script src="/js/move.js" defer></script>
    <script src="/js/donate.js" defer></script>
    <script src="/js/webpack.js" defer></script>
    <script type="text/javascript" src="/js/image-map-pro.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</body>

</html>