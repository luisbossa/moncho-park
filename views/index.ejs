<section id="hero" class="hero-section">
    <%- include("partials/header") %>

    <div class="hero-bg-video-wrapper" data-videos="<%= JSON.stringify(videos) %>">
        <video autoplay muted playsinline preload="auto" class="hero-bg-video" id="video1" src="<%= videos[0] %>"
            style="opacity: 1"></video>
        <video muted playsinline preload="none" class="hero-bg-video" id="video2"></video>
    </div>

    <audio id="bg-audio" autoplay muted loop>
        <source src="/audio/song-1.mp3" type="audio/mpeg">
    </audio>

    <div class="container hero-content-container">
        <h1 class="hero-title">
            <span>Moncho Park</span>
        </h1>
    </div>

    <a href="#about" class="hero-scroll" aria-label="Ir a la sección Acerca de"></a>

    <button id="audio-toggle" class="audio-btn" type="button" aria-label="Activar o silenciar música"
        aria-pressed="false">
        <img id="icon-sound-on" src="/images/icons/sounOn.svg" alt="">
        <img id="icon-sound-off" src="/images/icons/soundOff.svg" alt="">
    </button>
</section>

<section id="about" class="about-section">
    <div class="hero-filler"></div>
    <div class="container">
        <div class="about-content">
            <div class="about-title-wrapper">
                <h2 class="general-title-bg">Esto es</h2>
                <h3 class="about-title-fg">Moncho</h3>
                <h3 class="about-title-fg">Skatepark</h3>
            </div>
            <div class="about-text">
                <p>Es el primer espacio urbano dedicado al skate y BMX en San
                    Ramón, Alajuela. Diseñado para todos los niveles, cuenta con rampas, rieles y zonas técnicas que
                    invitan a la creatividad y la adrenalina sobre ruedas.</p>
                <p>Más que un skatepark, es un punto de encuentro. Un lugar donde la comunidad se une, el talento
                    local florece y la cultura urbana se vive con fuerza. Aquí empieza el movimiento que está
                    transformando San Ramón.</p>
                <%- include("partials/ui/btn-marquee", { text: "Historia", href: "/history" }) %>
            </div>
        </div>
        <div class="about-images">
            <div class="about-image-item">
                <img src="/images/about/bg-1.jpeg" alt="Skatepark background" loading="lazy">
            </div>
            <div class="about-image-item">
                <img src="/images/about/bg-2.jpeg" alt="Skatepark background" loading="lazy">
            </div>
        </div>
    </div>
</section>

<section class="park-section">
    <div id="park" class="park-header">
        <div class="park-title-wrapper">
            <h2 class="general-title-bg">Explora el</h2>
            <h3 class="general-title-fg">Parque</h3>
        </div>

        <p class="park-intro">
            Recorre cada rincón del skatepark: rampas, rieles, ledges y zonas técnicas para todos los niveles.
        </p>

        <ul class="park-info">
            <li class="park-info-card">
                <span class="park-info-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>
                </span>
                <div>
                    <span class="park-info-label">Ubicación</span>
                    <strong><%= park.location %></strong>
                </div>
            </li>
            <li class="park-info-card">
                <span class="park-info-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                </span>
                <div>
                    <span class="park-info-label">
                        Horario
                        <span class="park-status" data-open="<%= park.hours.open %>" data-close="<%= park.hours.close %>" hidden></span>
                    </span>
                    <strong><%= park.hours.label %></strong>
                </div>
            </li>
            <li class="park-info-card">
                <span class="park-info-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4l-5.2 2.7 1-5.8L3.5 9.2l5.9-.9z" /></svg>
                </span>
                <div>
                    <span class="park-info-label">Acceso</span>
                    <strong><%= park.access %></strong>
                </div>
            </li>
        </ul>
    </div>

    <div class="park-map-frame">
        <div class="park-map-bar">
            <span class="park-map-tag">Mapa interactivo</span>
            <span class="park-map-hint">
                <span class="park-map-hint-desktop">Pasa el cursor sobre los puntos para ver cada zona</span>
                <span class="park-map-hint-mobile"><%= park.zones.length %> zonas para patinar</span>
            </span>
        </div>

        <div class="park-map-wrapper">
            <div id="image-map-pro-6308"></div>
        </div>

        <img src="/images/map/skatepark-mobile.png" alt="Mapa del Skatepark" class="park-map-image" loading="lazy">
    </div>

    <div class="park-zones">
        <h4 class="park-zones-title">Zonas del parque <span><%= park.zones.length %></span></h4>
        <ul class="park-zones-list">
            <% park.zones.forEach((zone) => { %>
            <li><%= zone %></li>
            <% }) %>
        </ul>

        <%- include("partials/ui/btn-marquee", { text: "Cómo llegar", href: site.contact.mapsUrl, external: true }) %>
    </div>
</section>

<section class="shop-section">
    <div id="magazine" class="shop-teaser-container">
        <div class="shop-teaser-content">
            <div class="shop-title-wrapper">
                <h2 class="general-title-bg">Skate Moncho</h2>
                <h3 class="general-title-fg">Magazine</h3>
            </div>
            <p>
                Lo mejor del skate en fotos y videos en tiempo real. ¿Listo para ser parte del movimiento?
            </p>
            <%- include("partials/ui/btn-marquee", { text: "Explorar", href: "https://skatemoncho.vercel.app/", external: true }) %>
        </div>

        <div class="empty-div"></div>

        <div class="shop-teaser-image">
            <div class="elementor elementor-16">
                <div class="e-con-inner">
                    <div class="elementor-element elementor-widget-image" data-id="7d9a943" data-element_type="widget"
                        data-settings="{&quot;motion_fx_motion_fx_scrolling&quot;:&quot;yes&quot;,&quot;motion_fx_translateX_effect&quot;:&quot;yes&quot;,&quot;motion_fx_devices&quot;:[&quot;desktop&quot;],&quot;motion_fx_translateX_direction&quot;:&quot;negative&quot;,&quot;motion_fx_motion_fx_mouse&quot;:&quot;yes&quot;,&quot;motion_fx_mouseTrack_effect&quot;:&quot;yes&quot;,&quot;motion_fx_mouseTrack_speed&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:0.2,&quot;sizes&quot;:[]},&quot;motion_fx_translateX_speed&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:4,&quot;sizes&quot;:[]},&quot;motion_fx_translateX_affectedRange&quot;:{&quot;unit&quot;:&quot;%&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:{&quot;start&quot;:0,&quot;end&quot;:100}}}"
                        data-widget_type="image.default">
                        <img decoding="async" src="/images/magazine/skater.png" class="skater" alt="Skater jumping"
                            loading="lazy" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="div-filler"></div>

    <div class="shop-products-wrapper">
        <span class="products-ghost" aria-hidden="true">Moncho Shop</span>

        <div id="shop" class="products-container">
            <div class="product-gallery-info">
                <span class="products-eyebrow">Destacados de la tienda</span>

                <div class="product-counter" aria-hidden="true">
                    <span class="product-counter-current" id="product-counter">01</span>
                    <span class="product-counter-total">/ <%= String(sliderProducts.length).padStart(2, "0") %></span>
                </div>

                <div class="product-text" id="product-text" aria-live="polite">
                    <h2 id="product-title"><%= sliderProducts[0].name %></h2>
                    <p id="product-description"><%= sliderProducts[0].description %></p>
                </div>

                <div class="product-progress" aria-hidden="true">
                    <span class="product-progress-bar" id="product-progress-bar"
                        style="width: <%= (100 / sliderProducts.length).toFixed(2) %>%"></span>
                </div>

                <div class="product-actions">
                    <%- include("partials/ui/btn-marquee", { text: "Comprar", href: "/shop" }) %>

                    <div class="product-nav-arrows">
                        <button class="arrow-btn disabled" type="button" id="prev-btn" aria-label="Producto anterior" disabled>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
                        </button>
                        <button class="arrow-btn" type="button" id="next-btn" aria-label="Producto siguiente">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
                        </button>
                    </div>
                </div>
            </div>

            <div class="product-gallery" tabindex="0" role="region" aria-roledescription="carrusel"
                aria-label="Productos destacados">
                <div class="product-gallery-inner" id="product-gallery-inner">
                    <% sliderProducts.forEach((product, i) => { %>
                    <button type="button" class="product-card<%= i === 0 ? ' active' : '' %>" data-index="<%= i %>"
                        data-name="<%= product.name %>" data-description="<%= product.description %>"
                        aria-label="Ver <%= product.name %>">
                        <img src="<%= product.img %>" alt="" loading="<%= i < 3 ? 'eager' : 'lazy' %>" />
                    </button>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="bestsellers" class="bestsellers-section">
    <div class="container">
        <h2 class="general-title">Lo más vendido</h2>
        <div class="bestsellers-grid">
            <% bestSellers.forEach((product) => { %>
            <div class="product-item">
                <img src="<%= product.img %>" alt="<%= product.name %>" loading="lazy">
                <div class="product-info">
                    <h3><%= product.name %></h3>
                    <p><%= product.detail %></p>
                    <%- include("partials/ui/btn-marquee", { text: "Comprar", href: "/shop" }) %>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
</section>

<section id="discount" class="discount-section">
    <div class="container discount-container">
        <h2><span class="color-span">15%</span> DE DESCUENTO EN TU PRIMERA COMPRA ONLINE</h2>

        <form class="discount-form">
            <div class="discount-form-group">
                <input type="email" name="email" id="email" placeholder="Introducir Email" autocomplete="email"
                    required>
                <span class="error-message"></span>
            </div>

            <button type="submit" class="custome-btn">
                <span class="btn-text">Suscribir</span>
                <%- include("partials/ui/arrow-icon") %>
            </button>
        </form>
    </div>
</section>

<section id="brands" class="brands-wrapper">
    <div class="brands-title-wrapper">
        <h2 class="general-title-bg">Nuestros</h2>
        <h3 class="general-title-fg">Socios</h3>
    </div>

    <div class="brands-div">
        <img class="brand-img" src="/images/brands/brands.png" alt="Complete skateboard parts" loading="lazy">
    </div>
</section>
