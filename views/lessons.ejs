<section class="lessons-hero">

    <%- include("partials/header") %>

        <div class="lessons-container">
            <div class="lessons-hero-content">

                <h1 class="lessons-hero-title">
                    Clases de Skate
                </h1>

            </div>
        </div>

</section>


<section class="lessons-section">

    <div class="hero-filler"></div>

    <div class="lessons-container">

        <!-- INTRO -->

        <div class="lessons-intro">

            <div class="lessons-intro-text">

                <h2 class="lessons-title">Aprende en MonchoPark</h2>

                <p class="lessons-lead">
                    Clases de skate para todos los niveles, desde principiantes hasta riders avanzados.
                </p>

                <p>
                    En MonchoPark creemos que el skate no solo se aprende practicando, sino con la guía correcta.
                    Nuestras clases están diseñadas para que avances de forma segura, mejores tu técnica
                    y ganes confianza en cada sesión.
                </p>

                <div class="lessons-coach-info">
                    <h4>Entrena con Carlos Ocampo</h4>

                    <p>
                        Carlos Ocampo es instructor de skate con experiencia en formación de riders de todos los
                        niveles.
                        Su enfoque combina técnica, seguridad y estilo, ayudándote a progresar de forma real en el
                        skatepark.
                    </p>

                    <ul>
                        <li>✔ Clases personalizadas</li>
                        <li>✔ Corrección técnica en tiempo real</li>
                        <li>✔ Progreso adaptado a tu nivel</li>
                        <li>✔ Enfoque en confianza y control</li>
                    </ul>
                </div>

            </div>

            <div class="lessons-intro-image">
                <img src="/images/lessons/lessons-coach.png" alt="Carlos Ocampo - Instructor de skate">
            </div>

        </div>


        <!-- TARIFAS -->

        <div class="lessons-pricing">

            <h2 class="lessons-title-center">Tarifas</h2>

            <div class="lessons-pricing-grid">
                <!-- 1 PERSONA -->
                <div class="lessons-pricing-card">
                    <h3>1 persona</h3>
                    <p class="lessons-pricing-sub">Clase personalizada</p>

                    <ul>
                        <li><span>2 horas</span> <strong>₡24,000</strong></li>
                        <li><span>1h 30min</span> <strong>₡17,000</strong></li>
                        <li><span>1 hora</span> <strong>₡11,000</strong></li>
                    </ul>
                    <div class="go-bottom-div">
                        <a href="#lessons-form" class="btn-23">
                            <span class="text">Reservar</span>
                            <span aria-hidden="true" class="marquee">Reservar</span>
                        </a>
                    </div>
                </div>

                <!-- 2 PERSONAS (RECOMENDADO) -->
                <div class="lessons-pricing-card featured">
                    <div class="badge">Más popular</div>

                    <h3>2 personas</h3>
                    <p class="lessons-pricing-sub">Aprende acompañado</p>

                    <ul>
                        <li><span>2 horas</span> <strong>₡19,000 c/u</strong></li>
                        <li><span>1h 30min</span> <strong>₡14,000 c/u</strong></li>
                        <li><span>1 hora</span> <strong>₡9,000 c/u</strong></li>
                    </ul>
                    <div class="go-bottom-div">
                        <a href="#lessons-form" class="btn-23">
                            <span class="text">Reservar</span>
                            <span aria-hidden="true" class="marquee">Reservar</span>
                        </a>
                    </div>
                </div>

                <!-- 3 PERSONAS -->
                <div class="lessons-pricing-card">
                    <h3>3 personas</h3>
                    <p class="lessons-pricing-sub">Grupo dinámico</p>

                    <ul>
                        <li><span>2 horas</span> <strong>₡16,000 c/u</strong></li>
                        <li><span>1h 30min</span> <strong>₡12,000 c/u</strong></li>
                        <li><span>1 hora</span> <strong>₡8,000 c/u</strong></li>
                    </ul>
                    <div class="go-bottom-div">
                        <a href="#lessons-form" class="btn-23">
                            <span class="text">Reservar</span>
                            <span aria-hidden="true" class="marquee">Reservar</span>
                        </a>
                    </div>
                </div>

                <!-- 4 PERSONAS -->
                <div class="lessons-pricing-card">
                    <h3>4 personas</h3>
                    <p class="lessons-pricing-sub">Clase grupal</p>

                    <ul>
                        <li><span>2 horas</span> <strong>₡14,000 c/u</strong></li>
                        <li><span>1h 30min</span> <strong>₡10,000 c/u</strong></li>
                        <li><span>1 hora</span> <strong>₡7,000 c/u</strong></li>
                    </ul>
                    <div class="go-bottom-div">
                        <a href="#lessons-form" class="btn-23">
                            <span class="text">Reservar</span>
                            <span aria-hidden="true" class="marquee">Reservar</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>


        <!-- EXTRA -->

        <div class="lessons-extra">

            <h2 class="lessons-title-center">Alquiler de Equipo</h2>

            <div class="lessons-extra-grid">

                <!-- EQUIPO -->

                <div class="lessons-extra-card">

                    <div class="lessons-extra-header">
                        <i data-lucide="package"></i>
                        <h3>Equipo disponible</h3>
                    </div>

                    <p class="lessons-extra-desc">
                        Si no cuentas con equipo propio, en MonchoPark puedes alquilar todo lo necesario
                        para disfrutar tu sesión con seguridad y comodidad.
                    </p>

                    <ul class="lessons-extra-list">
                        <ul class="lessons-extra-list">

                            <li>
                                <span class="item">
                                    <img src="/images/icons/helmet.png" alt="Casco">
                                    Casco
                                </span>
                                <strong>₡2,000</strong>
                            </li>

                            <li>
                                <span class="item">
                                    <img src="/images/icons/skateboard.png" alt="Tabla">
                                    Tabla
                                </span>
                                <strong>₡4,000</strong>
                            </li>

                            <li>
                                <span class="item">
                                    <img src="/images/icons/helmet.png" alt="Casco">
                                    <img src="/images/icons/skateboard.png" alt="Tabla">
                                    Combo completo
                                </span>
                                <strong>₡6,000</strong>
                            </li>

                        </ul>
                    </ul>

                </div>

                <!-- CONDICIONES -->

                <div class="lessons-extra-card">

                    <div class="lessons-extra-header">
                        <i data-lucide="shield-check"></i>
                        <h3>Condiciones y seguridad</h3>
                    </div>

                    <p class="lessons-extra-desc">
                        Priorizamos la seguridad en cada sesión. Nuestro equipo se encuentra en buen estado
                        y es revisado constantemente.
                    </p>

                    <ul class="lessons-extra-list">
                        <li>Uso de casco obligatorio</li>
                        <li>Supervisión durante la práctica</li>
                        <li>Equipo higienizado</li>
                        <li>Asistencia para principiantes</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="lessons-values">

    <div class="lessons-overlay"></div>

    <div class="lessons-container">

        <h2 class="lessons-contact-title">Nuestra Filosofía</h2>

        <div class="lessons-values-grid">

            <div class="lessons-value-card">
                <i data-lucide="shield"></i>
                <h4>Seguridad ante todo</h4>
                <p>
                    Cada sesión está diseñada para minimizar riesgos y maximizar aprendizaje.
                    Utilizamos equipo adecuado y supervisión constante para que progreses con confianza.
                </p>
            </div>

            <div class="lessons-value-card">
                <i data-lucide="smile"></i>
                <h4>Aprender disfrutando</h4>
                <p>
                    El skate no es solo técnica, es actitud. Buscamos que cada clase sea una experiencia
                    divertida que te motive a seguir avanzando.
                </p>
            </div>

            <div class="lessons-value-card">
                <i data-lucide="users"></i>
                <h4>Comunidad real</h4>
                <p>
                    Fomentamos el respeto, el apoyo entre riders y una cultura positiva dentro del skatepark.
                    Aquí todos crecen juntos.
                </p>
            </div>

            <div class="lessons-value-card">
                <i data-lucide="trending-up"></i>
                <h4>Progreso constante</h4>
                <p>
                    Adaptamos cada clase a tu nivel para que avances de forma progresiva,
                    desde lo básico hasta trucos más avanzados.
                </p>
            </div>

        </div>

    </div>

</section>

<section class="lessons-contact" id="lessons-form">

    <div class="lessons-container">

        <div class="lessons-contact-grid">

            <!-- LEFT -->

            <div class="lessons-contact-left">
                <h2 class="lessons-contact-title">
                    Contacta<br>con nosotros
                </h2>
            </div>


            <!-- RIGHT -->

            <div class="lessons-contact-right">

                <form class="lessons-form">
                    <input type="text" placeholder="Nombre">
                    <input type="email" placeholder="Correo electrónico">
                    <input type="tel" placeholder="Teléfono">
                    <textarea placeholder="Mensaje"></textarea>

                    <div class="lessons-checkbox-group">
                        <p>¿Qué tipo de clases te interesan?</p>

                        <label>
                            <input type="checkbox">
                            <span>Clases personalizadas</span>
                        </label>

                        <label>
                            <input type="checkbox">
                            <span>Clases grupales</span>
                        </label>

                        <label>
                            <input type="checkbox">
                            <span>Sesión en Skatepark</span>
                        </label>
                    </div>

                    <button type="submit" class="btn-23">
                        <span class="text">Enviar</span>
                        <span aria-hidden="true" class="marquee">Enviar</span>
                    </button>
                </form>

            </div>

        </div>

    </div>

</section>

<script src="/js/lessons.js" defer></script>