<%- include("partials/page-hero", { sectionClass: "lessons-hero", prefix: "lessons", heading: "Clases de Skate" }) %>

<section class="lessons-section">
    <div class="hero-filler"></div>

    <div class="lessons-container">

        <!-- INTRO -->
        <div class="lessons-intro">
            <div class="lessons-intro-text">
                <h2 class="lessons-title">Aprende en MonchoPark</h2>

                <p class="lessons-lead">
                    Clases de skate para todos los niveles, desde principiantes hasta riders avanzados.
                </p>

                <p>
                    En MonchoPark creemos que el skate no solo se aprende practicando, sino con la guía correcta.
                    Nuestras clases están diseñadas para que avances de forma segura, mejores tu técnica
                    y ganes confianza en cada sesión.
                </p>

                <div class="lessons-coach-info">
                    <h4>Entrena con Carlos Ocampo</h4>

                    <p>
                        Carlos Ocampo es instructor de skate con experiencia en formación de riders de todos los
                        niveles. Su enfoque combina técnica, seguridad y estilo, ayudándote a progresar de forma real
                        en el skatepark.
                    </p>

                    <ul>
                        <% coachPerks.forEach((perk) => { %>
                        <li>✔ <%= perk %></li>
                        <% }) %>
                    </ul>
                </div>
            </div>

            <div class="lessons-intro-image">
                <img src="/images/lessons/lessons-coach.png" alt="Carlos Ocampo - Instructor de skate">
            </div>
        </div>

        <!-- TARIFAS -->
        <div class="lessons-pricing">
            <h2 class="lessons-title-center">Tarifas</h2>

            <div class="lessons-pricing-grid">
                <% pricing.forEach((plan) => { %>
                <div class="lessons-pricing-card<%= plan.featured ? ' featured' : '' %>" data-plan-card="<%= plan.title %>">
                    <% if (plan.badge) { %>
                    <div class="badge"><%= plan.badge %></div>
                    <% } %>

                    <h3><%= plan.title %></h3>
                    <p class="lessons-pricing-sub"><%= plan.subtitle %></p>

                    <ul>
                        <% plan.rates.forEach((rate) => { %>
                        <li><span><%= rate.duration %></span> <strong><%= rate.price %></strong></li>
                        <% }) %>
                    </ul>
                    <div class="go-bottom-div">
                        <%- include("partials/ui/btn-marquee", { text: "Reservar", href: "#lessons-form", attrs: { "data-plan": plan.title, "aria-label": "Reservar clase para " + plan.title } }) %>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

        <!-- EXTRA -->
        <div class="lessons-extra">
            <h2 class="lessons-title-center">Alquiler de Equipo</h2>

            <div class="lessons-extra-grid">
                <div class="lessons-extra-card">
                    <div class="lessons-extra-header">
                        <i data-lucide="package"></i>
                        <h3>Equipo disponible</h3>
                    </div>

                    <p class="lessons-extra-desc">
                        Si no cuentas con equipo propio, en MonchoPark puedes alquilar todo lo necesario
                        para disfrutar tu sesión con seguridad y comodidad.
                    </p>

                    <ul class="lessons-extra-list">
                        <% rental.forEach((item) => { %>
                        <li>
                            <span class="item">
                                <% item.icons.forEach((icon) => { %>
                                <img src="<%= icon.src %>" alt="<%= icon.alt %>">
                                <% }) %>
                                <%= item.label %>
                            </span>
                            <strong><%= item.price %></strong>
                        </li>
                        <% }) %>
                    </ul>
                </div>

                <div class="lessons-extra-card">
                    <div class="lessons-extra-header">
                        <i data-lucide="shield-check"></i>
                        <h3>Condiciones y seguridad</h3>
                    </div>

                    <p class="lessons-extra-desc">
                        Priorizamos la seguridad en cada sesión. Nuestro equipo se encuentra en buen estado
                        y es revisado constantemente.
                    </p>

                    <ul class="lessons-extra-list">
                        <% conditions.forEach((condition) => { %>
                        <li><%= condition %></li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="lessons-values">
    <div class="lessons-overlay"></div>

    <div class="lessons-container">
        <h2 class="lessons-contact-title lessons-color">Nuestra Filosofía</h2>

        <div class="lessons-values-grid">
            <% values.forEach((value) => { %>
            <div class="lessons-value-card">
                <i data-lucide="<%= value.icon %>"></i>
                <h4><%= value.title %></h4>
                <p><%= value.text %></p>
            </div>
            <% }) %>
        </div>
    </div>
</section>

<section class="lessons-contact" id="lessons-form">
    <div class="lessons-container">
        <div class="lessons-contact-grid">
            <div class="lessons-contact-left">
                <h2 class="lessons-contact-title">
                    Contacta<br>con nosotros
                </h2>
            </div>

            <div class="lessons-contact-right">
                <form class="lessons-form" novalidate>
                    <div class="lessons-form-plan" aria-live="polite">
                        <span>Plan seleccionado: <strong></strong></span>
                        <button type="button" aria-label="Quitar plan seleccionado">✕</button>
                    </div>
                    <input type="hidden" name="plan">

                    <input type="text" name="name" placeholder="Nombre" aria-label="Nombre" autocomplete="name">
                    <input type="email" name="email" placeholder="Correo electrónico" aria-label="Correo electrónico" autocomplete="email" inputmode="email">
                    <input type="tel" name="phone" placeholder="Teléfono" aria-label="Teléfono" autocomplete="tel" inputmode="tel">
                    <textarea name="message" placeholder="Mensaje" aria-label="Mensaje"></textarea>

                    <div class="lessons-checkbox-group">
                        <p>¿Qué tipo de clases te interesan?</p>

                        <% classTypes.forEach((type) => { %>
                        <label>
                            <input type="checkbox" name="classTypes" value="<%= type %>">
                            <span><%= type %></span>
                        </label>
                        <% }) %>
                    </div>

                    <%- include("partials/ui/btn-marquee", { text: "Enviar", type: "submit" }) %>

                    <template class="sent-template">
                        ¡Enviado! <img class="checked-icon" src="/images/icons/checked.webp" alt="" />
                    </template>
                </form>
            </div>
        </div>
    </div>
</section>
