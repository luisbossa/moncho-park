<section class="donate-hero">

    <%- include("partials/header") %>

        <div class="donate-container">
            <div class="donate-hero-content">
                <h1 class="donate-hero-title">
                    Hazlo crecer
                </h1>
            </div>
        </div>

</section>


<section class="donate-section">
    <div class="hero-filler"></div>

    <div class="donate-container">

        <!-- LEFT -->
        <div class="donate-box">

            <div class="donate-box-header">
                <h3>Donar de forma segura</h3>
                <p>Apoya el crecimiento del skate en San Ramón</p>
            </div>

            <!-- tipo -->
            <div class="donate-type">
                <button class="donate-type-btn active" data-type="once">Una vez</button>
                <button class="donate-type-btn" data-type="monthly">Mensual</button>
            </div>

            <!-- montos -->
            <div class="donate-amounts">
                <button class="donate-amount-btn">₡2,000</button>
                <button class="donate-amount-btn">₡3,500</button>
                <button class="donate-amount-btn">₡5,000</button>
                <button class="donate-amount-btn">₡7,000</button>
            </div>

            <!-- custom -->
            <div class="donate-custom">
                <span>₡</span>
                <input type="number" placeholder="Otra cantidad" max="20000">
            </div>

            <!-- botón -->
            <div class="donate-div">
                <a href="#" class="btn-23 donate-btn">
                    <span class="text">Donar</span>
                    <span aria-hidden="true" class="marquee">Donar</span>
                </a>
            </div>

            <div class="message-div">
                <p class="donate-message">¡Gracias por tu apoyo!</p>
            </div>

            <!-- seguridad -->
            <div class="donate-security">
                <img class="donate-img" src="/images/icons/shield.png" alt="Shield security">
                <p>Pago 100% seguro</p>
            </div>

        </div>


        <!-- RIGHT -->
        <div class="donate-info">

            <h2>Tu aporte hace la diferencia</h2>

            <p>
                Mantener y mejorar MonchoPark requiere esfuerzo constante. Los fondos se utilizan para mantenimiento,
                limpieza y eventos.
            </p>

            <p>
                Gracias a personas como tú, el skate en San Ramón sigue creciendo.
            </p>
        </div>

    </div>
</section>

<script src="/js/donate.js" defer></script>